# Firebase web app configuration (safe to expose in a browser app; Firestore
# Security Rules protect the data).
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Separate OAuth client used only when a signed-in user connects Calendar.
VITE_GOOGLE_CLIENT_ID=google-client-id-here
VITE_GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
